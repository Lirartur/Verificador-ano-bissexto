from datetime import date
ano = int(input('digite o ano para saber se eh bissexto. escreva 0 se quiser verificar o ano atual: '))

if ano == 0:
    ano = date.today().year
if ano % 4 == 0 and ano % 100 != 0 or ano % 400 == 0:
    print('o ano eh bissexto :(')
else:
    print('o ano nao eh bisexto :)')
